# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=192.168.178.175,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.178.175:8001
SQLITE_PATH=/app/data/db.sqlite3
DJANGO_MEDIA_ROOT=/app/data/media

DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0

# Spotify
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=
SPOTIFY_TOKEN_ENCRYPTION_KEY=
SPOTIFY_PLAYBACK_CACHE_SECONDS=8

# Shared OAuth token encryption (falls back to SPOTIFY_TOKEN_ENCRYPTION_KEY)
NEXORA_OAUTH_TOKEN_ENCRYPTION_KEY=

# Email (used for password reset messages)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_USE_SSL=false
DJANGO_DEFAULT_FROM_EMAIL=Nexora <noreply@example.com>

# Rate limiting (per client IP; 0 disables a limit)
DJANGO_LOGIN_RATE_LIMIT_ATTEMPTS=10
DJANGO_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
DJANGO_SIGNUP_RATE_LIMIT_ATTEMPTS=10
DJANGO_SIGNUP_RATE_LIMIT_WINDOW_SECONDS=300
DJANGO_PASSWORD_RESET_RATE_LIMIT_ATTEMPTS=5
DJANGO_PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=300

# Twitch
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret
TWITCH_REDIRECT_URI=http://localhost:8000/goals/twitch/callback/
TWITCH_METRIC_CACHE_SECONDS=15
